// Prisma Schema for Bouaziz Matériel Agricole

datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model Category {
  id            Int       @id @default(autoincrement())
  slug          String    @unique
  name          String    @db.VarChar(255)
  nameAr        String    @db.VarChar(255)
  description   String    @db.Text
  descriptionAr String    @db.Text
  icon          String    @db.VarChar(100)
  image         String    @db.VarChar(500)
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Product {
  id            Int       @id @default(autoincrement())
  slug          String    @unique
  name          String    @db.VarChar(500)
  nameAr        String    @db.VarChar(500)
  description   String    @db.Text
  descriptionAr String    @db.Text
  price         Float
  oldPrice      Float?
  inStock       Boolean   @default(true)
  badge         String?   @db.VarChar(100)
  badgeAr       String?   @db.VarChar(100)
  specBadge     String?   @db.VarChar(200)
  specBadgeAr   String?   @db.VarChar(200)
  specSub       String?   @db.VarChar(500)
  specSubAr     String?   @db.VarChar(500)
  image         String    @db.VarChar(500)
  thumbnail     String    @db.VarChar(500)
  isHidden      Boolean   @default(false)
  deletedAt     DateTime?
  categoryId    Int
  category      Category  @relation(fields: [categoryId], references: [id])
  features      Feature[]
  variants      Variant[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([categoryId])
}

model Feature {
  id        Int     @id @default(autoincrement())
  text      String  @db.Text
  textAr    String  @db.Text
  sortOrder Int     @default(0)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Variant {
  id          Int     @id @default(autoincrement())
  label       String  @db.VarChar(300)
  labelAr     String  @db.VarChar(300)
  title       String  @db.VarChar(500)
  titleAr     String  @db.VarChar(500)
  specBadge   String? @db.VarChar(200)
  specBadgeAr String? @db.VarChar(200)
  specSub     String? @db.VarChar(500)
  specSubAr   String? @db.VarChar(500)
  price       Float
  sortOrder   Int     @default(0)
  productId   Int
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}
